<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp"
    android:background="@drawable/widget_background" android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/closest_to_five" android:textSize="12sp" android:textColor="@color/widget_secondary" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="@string/preview_city" android:textSize="26sp" android:textColor="@color/widget_primary" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/preview_time" android:textSize="46sp" android:textColor="@color/widget_accent" android:fontFamily="sans-serif-light" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/preview_country" android:textSize="12sp" android:textColor="@color/widget_secondary" />
</LinearLayout>
