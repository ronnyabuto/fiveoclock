<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/toolbar" android:layout_alignParentTop="true" android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/closest_to_five" android:textColor="#9CAFA7" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/refresh" android:layout_width="56dp" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/refresh" android:textColor="#F5AE46" android:textSize="11sp"
            android:contentDescription="@string/refresh_description" android:background="?android:attr/selectableItemBackground" />
        <ImageButton android:id="@+id/settings" android:layout_width="32dp" android:layout_height="match_parent"
            android:src="@android:drawable/ic_menu_preferences" android:tint="#9CAFA7" android:padding="7dp"
            android:contentDescription="@string/settings_description" android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
    <LinearLayout android:layout_below="@id/toolbar" android:layout_above="@id/distance" android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextClock android:id="@+id/digital_clock" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:format12Hour="HH:mm:ss" android:format24Hour="HH:mm:ss" android:textSize="34sp"
                android:textColor="#F5AE46" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"
                android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/city" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="20sp" android:textColor="#F3F1E9" android:maxLines="1" android:ellipsize="end"
                android:includeFontPadding="false" android:layout_marginTop="3dp" />
            <TextView android:id="@+id/country" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9CAFA7" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/offset" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#FFD18A" android:maxLines="1" />
        </LinearLayout>
        <AnalogClock android:id="@+id/analogue_clock" android:layout_width="96dp" android:layout_height="96dp"
            android:layout_marginStart="8dp" android:visibility="visible" android:importantForAccessibility="no"
            android:dial="@drawable/clock_dial" android:hand_hour="@drawable/clock_hour"
            android:hand_minute="@drawable/clock_minute" android:hand_second="@drawable/clock_second" />
    </LinearLayout>
    <Chronometer android:layout_alignParentBottom="true" android:id="@+id/distance" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#C5CEC9" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</RelativeLayout>
